{
  "vocabulary": "hospital-triage-v1",
  "variant": "signsphere-hospital-v1",
  "description": "Focused sign vocabulary for the SignSphere hospital triage kiosk. Recognition output is constrained to these glosses; unrestricted translation is out of scope. Gestures are not assumed to be universal across sign languages: you record each sign yourself in the Train screen, so the model matches how YOUR signers sign it. 'reuse' lists glosses whose recordings are taken from the VIBETALK restaurant model (data/restaurant-signs-model.json) so those signs do not have to be recorded again.",
  "reuse": {
    "yes": "yes", "no": "no", "help": "help", "confirm": "confirm", "cancel": "cancel",
    "one": "one", "two": "two", "three": "three", "four": "four", "five": "five"
  },
  "categories": {
    "control": "Signs the patient uses to accept or discard what the screen understood.",
    "answer": "Yes / No.",
    "number": "Numbers used for durations.",
    "body": "Where the problem is.",
    "time": "How long it has been going on.",
    "severity": "How bad it is.",
    "symptom": "Other symptoms.",
    "reply": "Extra words for replying to the doctor."
  },
  "glosses": [
    {"id": "confirm", "cat": "control", "en": "Confirm", "ur": "تصدیق"},
    {"id": "cancel", "cat": "control", "en": "Cancel", "ur": "منسوخ"},
    {"id": "yes", "cat": "answer", "en": "Yes", "ur": "جی ہاں"},
    {"id": "no", "cat": "answer", "en": "No", "ur": "نہیں"},
    {"id": "help", "cat": "reply", "en": "Help", "ur": "مدد"},

